{
  "name": "uzoni",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:api:watch": "node --watch server/index.js",
    "dev:web": "vite",
    "db:setup": "node server/migrate.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/money.test.mjs && node scripts/import.test.mjs && node scripts/sms.test.mjs",
    "test:api": "bash scripts/api-test.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^0.451.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "description": "A local-first personal finance manager: accounts, transactions, budgets, goals and debts, running on your own PostgreSQL database.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
